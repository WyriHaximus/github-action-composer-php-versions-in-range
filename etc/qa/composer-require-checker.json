{
  "symbol-whitelist" : [
    "null", "true", "false",
    "static", "self", "parent",
    "array", "string", "int", "float", "bool", "iterable", "callable", "void", "object",
    "JsonSerializable",
    "json_decode",
    "json_encode",
    "JSON_PRETTY_PRINT",
    "JSON_THROW_ON_ERROR",
    "JSON_UNESCAPED_SLASHES",
    "React\\Async\\async",
    "React\\Async\\await",
    "React\\EventLoop\\Loop",
    "React\\Http\\Browser",
    "React\\Promise\\Deferred",
    "React\\Promise\\Promise",
    "React\\Promise\\PromiseInterface",
    "React\\Promise\\all",
    "React\\Promise\\reject",
    "React\\Promise\\resolve",
    "Psr\\Http\\Message\\ResponseInterface"
  ],
  "php-core-extensions" : [
    "Core",
    "date",
    "pcre",
    "Phar",
    "Reflection",
    "SPL",
    "standard"
  ],
  "scan-files" : []
}
