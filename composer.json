{
  "name": "wyrihaximus/github-action-composer-php-versions-in-range",
  "description": "GitHub Action for determining Composer PHP versions in range",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "react/http": "^1.12.0",
    "wyrihaximus/simple-twig": "^2.4.0"
  },
  "require-dev": {
    "wyrihaximus/async-test-utilities": "^14.8.0",
    "wyrihaximus/makefiles": "^0.16.1"
  },
  "autoload": {
    "psr-4": {
      "WyriHaximus\\GitHubAction\\ComposerPhpVersionsInRange\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WyriHaximus\\GitHubAction\\ComposerPhpVersionsInRange\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.5.13"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
